# =============================================================================
# ALL-IN-ONE LIFE OS : 환경 변수 설정 (.env)
# =============================================================================

# LLM 제공자 선택 (grok, openai, gemini, mock 중 택 1, 기본값: mock)
# mock 모드는 API 키 없이도 내장된 고성능 NLP 엔진으로 즉시 작동합니다.
LLM_PROVIDER=mock

# xAI Grok API 키 (Grok Bot 연동 시 사용)
GROK_API_KEY=your_xai_grok_api_key_here

# OpenAI API 키 (ChatGPT 연동 시 사용)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API 키
GEMINI_API_KEY=your_gemini_api_key_here

# 텔레그램 봇 토큰 (Telegram BotFather에서 발급받은 토큰)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 디스코드(Discord) 봇 토큰 & 선택 전용 채널 ID
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=

# 표시 언어 (기본값: auto — OS 언어 자동 감지, 선택: auto, ko, en, ja, zh)
LIFE_OS_LANG=auto

# 엑셀 파일 경로 (기본 파일: Life_OS_Successful_Habits.xlsx)
EXCEL_PATH=Life_OS_Successful_Habits.xlsx

# 웹훅 서버 포트
PORT=8080
